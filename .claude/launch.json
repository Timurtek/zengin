{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@zenginui/ui",
        "storybook"
      ],
      "port": 6006
    },
    {
      "name": "marketing-site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "marketing-site",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "review-workspace",
      "runtimeExecutable": "pnpm",
