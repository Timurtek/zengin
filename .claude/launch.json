{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@zengin/ui",
        "storybook"
      ],
      "port": 6006
    },
    {
      "name": "marketing-site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "marketing-site",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "review-workspace",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "review-workspace",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "ui-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "packages/ui"
      ],
      "port": 4173
    },
    {
      "name": "blank",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "blank",
        "dev"
      ],
      "port": 5175
    },
    {
      "name": "saas",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "saas",
        "dev"
      ],
      "port": 5176
    }
  ]
}
