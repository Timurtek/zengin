{
  "name": "@zenginui/adapter-shadcn",
  "version": "0.1.4",
  "description": "Derives Zengin definitions from a shadcn/ui project: theme variables, Tailwind config, and the cva() calls in components/ui.",
  "license": "MIT",
  "type": "module",
  "keywords": ["design-system", "shadcn", "tailwind", "zengin"],
  "repository": { "type": "git", "url": "git+https://github.com/Timurtek/zengin.git", "directory": "packages/adapter-shadcn" },
  "homepage": "https://github.com/Timurtek/zengin/tree/main/packages/adapter-shadcn#readme",
  "bugs": "https://github.com/Timurtek/zengin/issues",
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^8.0.5",
    "@zenginui/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
