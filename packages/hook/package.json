{
  "name": "@zenginui/hook",
  "version": "0.1.3",
  "description": "Claude Code PostToolUse hook that checks every file write against the design system.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "design-system",
    "design-tokens",
    "lint",
    "conformance",
    "coding-agents",
    "zengin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timurtek/zengin.git",
    "directory": "packages/hook"
  },
  "homepage": "https://github.com/Timurtek/zengin/tree/main/packages/hook#readme",
  "bugs": "https://github.com/Timurtek/zengin/issues",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zengin-hook": "./dist/index.js"
  },
  "main": "./dist/hook.js",
  "types": "./dist/hook.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zenginui/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
