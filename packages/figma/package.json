{
  "name": "@zengin/figma",
  "version": "0.0.1",
  "description": "Figma both ways for a Zengin system: tokens to Figma variables and back, Code Connect files from the component manifest, and a plugin that imports and exports variables in any file.",
  "license": "MIT",
  "type": "module",
  "keywords": ["design-tokens", "figma", "variables", "code-connect", "zengin"],
  "repository": { "type": "git", "url": "git+https://github.com/Timurtek/zengin.git", "directory": "packages/figma" },
  "homepage": "https://github.com/Timurtek/zengin/tree/main/packages/figma#readme",
  "bugs": "https://github.com/Timurtek/zengin/issues",
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zengin/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
