{
  "name": "@zenginui/registry",
  "version": "0.5.1",
  "description": "The Zengin registry: components, templates and definitions as installable items, plus the project generator behind `zengin create` and `zengin add`.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "design-system",
    "registry",
    "scaffold",
    "generator",
    "zengin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timurtek/zengin.git",
    "directory": "packages/registry"
  },
  "homepage": "https://github.com/Timurtek/zengin/tree/main/packages/registry#readme",
  "bugs": "https://github.com/Timurtek/zengin/issues",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/versions.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/versions.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/versions.mjs && vitest run"
  },
  "dependencies": {
    "@zenginui/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "react-icons": "^5.7.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
