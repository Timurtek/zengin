{
  "name": "@zenginui/mcp",
  "version": "0.1.4",
  "description": "MCP server exposing the Zengin conformance engine to coding agents.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "design-system",
    "design-tokens",
    "lint",
    "conformance",
    "coding-agents",
    "zengin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timurtek/zengin.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Timurtek/zengin/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/Timurtek/zengin/issues",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zengin-mcp": "./dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@zenginui/engine": "workspace:*",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
