{
  "$description": "Zengin default theme (light). Semantic tokens only; components reference these and nothing else.",
  "color": {
    "$type": "color",
    "surface": {
      "$value": "#FFFFFF",
      "$description": "Page and card background."
    },
    "surface-raised": {
      "$value": "#F8FAFC",
      "$description": "Slightly lifted surfaces: headers, soft buttons at rest."
    },
    "surface-sunken": {
      "$value": "#F1F5F9",
      "$description": "Inset surfaces: inputs, code blocks."
    },
    "surface-overlay": {
      "$value": "#0F172ACC",
      "$description": "Scrim behind dialogs."
    },
    "text": {
      "$value": "#0F172A"
    },
    "text-muted": {
      "$value": "#475569"
    },
    "text-subtle": {
      "$value": "#94A3B8",
      "$description": "Placeholders and disabled text."
    },
    "border": {
      "$value": "#E2E8F0"
    },
    "border-strong": {
      "$value": "#CBD5E1",
      "$description": "Input borders at rest and hover."
    },
    "primary": {
      "DEFAULT": {
        "$value": "#2563EB"
      },
      "hover": {
        "$value": "#1D4ED8"
      },
      "active": {
        "$value": "#1E40AF"
      },
      "soft": {
        "$value": "#DBEAFE",
        "$description": "Soft variant background."
      },
      "soft-hover": {
        "$value": "#BFDBFE"
      },
      "soft-foreground": {
        "$value": "#1E40AF",
        "$description": "Text on the soft tint. Chosen for contrast, not hue."
      }
    },
    "on-primary": {
      "$value": "#FFFFFF"
    },
    "danger": {
      "DEFAULT": {
        "$value": "#DC2626"
      },
      "hover": {
        "$value": "#B91C1C"
      },
      "active": {
        "$value": "#991B1B"
      },
      "soft": {
        "$value": "#FEE2E2"
      },
      "soft-hover": {
        "$value": "#FECACA"
      },
      "soft-foreground": {
        "$value": "#991B1B"
      }
    },
    "on-danger": {
      "$value": "#FFFFFF"
    },
    "success": {
      "DEFAULT": {
        "$value": "#15803D"
      },
      "soft": {
        "$value": "#DCFCE7"
      },
      "soft-foreground": {
        "$value": "#166534"
      }
    },
    "on-success": {
      "$value": "#FFFFFF"
    },
    "warning": {
      "DEFAULT": {
        "$value": "#B45309"
      },
      "soft": {
        "$value": "#FEF3C7"
      },
      "soft-foreground": {
        "$value": "#92400E"
      }
    },
    "on-warning": {
      "$value": "#FFFFFF"
    },
    "neutral": {
      "DEFAULT": {
        "$value": "#334155",
        "$description": "Neutral solid buttons and badges."
      },
      "hover": {
        "$value": "#1E293B"
      },
      "active": {
        "$value": "#0F172A"
      },
      "soft": {
        "$value": "#E2E8F0"
      },
      "soft-hover": {
        "$value": "#CBD5E1"
      },
      "soft-foreground": {
        "$value": "#0F172A"
      }
    },
    "on-neutral": {
      "$value": "#FFFFFF"
    },
    "focus": {
      "$value": "#3B82F6",
      "$description": "Focus ring."
    },
    "outline": {
      "$value": "transparent",
      "$description": "The border color a component starts with before a variant sets one: invisible by default, so a theme can draw a rule around every control at once."
    }
  },
  "space": {
    "$type": "dimension",
    "0": {
      "$value": "0px"
    },
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    },
    "10": {
      "$value": "40px"
    },
    "12": {
      "$value": "48px"
    },
    "16": {
      "$value": "64px"
    },
    "20": {
      "$value": "80px"
    },
    "24": {
      "$value": "96px"
    },
    "32": {
      "$value": "128px"
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "6px"
    },
    "lg": {
      "$value": "10px"
    },
    "xl": {
      "$value": "16px"
    },
    "full": {
      "$value": "9999px"
    }
  },
  "border": {
    "$type": "dimension",
    "$description": "Rule weight. Every component border is var(--border-width) solid <color>; a theme sets it once.",
    "width": {
      "$value": "1px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": "0 1px 2px 0 rgb(15 23 42 / 0.06)"
    },
    "md": {
      "$value": "0 4px 8px -2px rgb(15 23 42 / 0.10), 0 2px 4px -2px rgb(15 23 42 / 0.06)"
    },
    "lg": {
      "$value": "0 12px 24px -6px rgb(15 23 42 / 0.16), 0 4px 8px -4px rgb(15 23 42 / 0.08)"
    }
  },
  "text": {
    "$type": "dimension",
    "xs": {
      "$value": "0.75rem"
    },
    "sm": {
      "$value": "0.875rem"
    },
    "base": {
      "$value": "1rem"
    },
    "lg": {
      "$value": "1.125rem"
    },
    "xl": {
      "$value": "1.25rem"
    },
    "2xl": {
      "$value": "1.5rem"
    },
    "3xl": {
      "$value": "1.875rem"
    },
    "4xl": {
      "$value": "2.25rem"
    },
    "5xl": {
      "$value": "3rem"
    },
    "6xl": {
      "$value": "3.75rem"
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    "mono": {
      "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "display": {
      "$value": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "$description": "Headlines and display text. The default theme sets it to the sans face; a brand theme may override it alone."
    }
  },
  "weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": 400
    },
    "medium": {
      "$value": 500
    },
    "semibold": {
      "$value": 600
    }
  },
  "leading": {
    "$type": "number",
    "tight": {
      "$value": 1.25
    },
    "normal": {
      "$value": 1.5
    },
    "none": {
      "$value": "1.05",
      "$description": "Display headlines."
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "120ms",
      "$description": "Hover and press feedback."
    },
    "normal": {
      "$value": "200ms",
      "$description": "Enter and exit of small surfaces."
    },
    "slow": {
      "$value": "320ms",
      "$description": "Dialogs and larger movements."
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": {
      "$value": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "emphasized": {
      "$value": "cubic-bezier(0.3, 0, 0, 1)"
    },
    "exit": {
      "$value": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Viewport widths the layouts change at. Media queries cannot read custom properties, so write the value; this is the list to write from.",
    "sm": {
      "$value": "40rem"
    },
    "md": {
      "$value": "52rem"
    },
    "lg": {
      "$value": "64rem"
    },
    "xl": {
      "$value": "80rem"
    }
  }
}
