{
  "name": "@zengin/rollup",
  "version": "0.0.1",
  "description": "Drift and adoption reporting across every repository that consumes a design system, from Zengin report snapshots.",
  "license": "MIT",
  "type": "module",
  "keywords": ["design-system", "drift", "adoption", "reporting", "zengin"],
  "repository": { "type": "git", "url": "git+https://github.com/Timurtek/zengin.git", "directory": "packages/rollup" },
  "homepage": "https://github.com/Timurtek/zengin/tree/main/packages/rollup#readme",
  "bugs": "https://github.com/Timurtek/zengin/issues",
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zengin/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
