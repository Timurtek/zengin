{
  "name": "storefront",
  "private": true,
  "version": "0.0.0",
  "description": "The storefront template: a product grid with search, filters and sort, a cart sheet with quantities and totals, and a checkout dialog that places the order, on @zenginui/ui.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node ../../packages/cli/dist/index.js check",
    "test": "node ../../packages/cli/dist/index.js check",
    "mock": "node ../../packages/cli/dist/index.js mock --schema mock.json"
  },
  "dependencies": {
    "@zenginui/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@zenginui/cli": "workspace:*",
    "react-icons": "^5.7.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
}
