  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@zenginui/cli": "workspace:*",
    "puppeteer-core": "^25.10.0",
    "react-icons": "^5.7.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
